# ===================================================================
# Beroe AWB — production env template.
# Copy this file to `.env.prod` and fill in the real values.
# DO NOT commit .env.prod to git — it contains secrets.
#
# REUSING the existing dev Supabase project? Lift the values straight
# from the developer's `apps/api/.env` (DATABASE_URL, SUPABASE_*) and
# `apps/web/.env` (VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY). Migrations
# + storage buckets + seed users are already in place. The lines below
# already have the project URL pre-filled for that project.
# ===================================================================

# -------- Frontend (Vite, baked into the bundle at build time) --------
# URL the browser hits for API calls. If api is reachable on the same
# host (single-VM deploy), use http://<host>:8000 ; if behind nginx /
# load balancer, use the public https URL.
VITE_API_BASE_URL=https://awb-api.beroe.internal

# Supabase project — pre-filled to the existing dev project.
VITE_SUPABASE_URL=https://fclkazponiwvmvzgvwei.supabase.co
VITE_SUPABASE_ANON_KEY=<copy-from-apps-web-env>   # public — safe to ship in JS

# -------- Backend (FastAPI + Celery) --------
# Transaction-mode pooler (port 6543) — required for prod concurrency
# on Supabase Free tier. The app sets `statement_cache_size=0` for this.
DATABASE_URL=postgresql+asyncpg://postgres.fclkazponiwvmvzgvwei:<password>@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres

# Supabase server-side keys (lift from apps/api/.env on the dev machine).
SUPABASE_URL=https://fclkazponiwvmvzgvwei.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<copy-from-apps-api-env>   # SECRET — server-only, bypasses RLS

# JWT secret used to verify incoming user tokens (HS256 / ES256 dispatcher).
SUPABASE_JWT_SECRET=<copy-from-apps-api-env>

# -------- AI gateway (preferred) --------
# Beroe's internal Bifrost gateway routes Claude through their own quota
# and audit. Use this when reachable from the deploy host.
AI_GATEWAY_URL=http://bifrost.beroe.internal:8087/v1
AI_GATEWAY_API_KEY=beroe-bedrock-prod-for-csm
AI_GATEWAY_MODEL=bedrock/eu.anthropic.claude-sonnet-4-7-20251101-v1:0

# -------- AI direct (fallback) --------
# Leave blank to force the gateway path. Set ONLY if Bifrost isn't
# reachable from the deploy host.
ANTHROPIC_API_KEY=

# -------- Storage (Supabase Storage buckets — meeting_records/vpd/contracts) --------
# Auto-derived from SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above; no extra config needed.

# -------- App-level toggles --------
ENV=production
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=100
CLAUDE_USER_DAILY_LIMIT=200
ALLOWED_DOC_EXTENSIONS=.docx,.doc,.pptx,.ppt,.xlsx,.xls,.pdf,.txt,.vtt,.eml,.csv,.md,.markdown
